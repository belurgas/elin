{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elin",
  "version": "0.9.6",
  "identifier": "com.elin.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Elin",
        "width": 1280,
        "height": 840,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "backgroundColor": "#0B0A12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://builds.hex.pm https://hex.pm https://api.github.com https://elixir-lang.org"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Elin",
    "copyright": "Copyright © 2026 Elin contributors",
    "category": "DeveloperTool",
    "shortDescription": "Elixir + Erlang, without the scavenger hunt.",
    "longDescription": "Elin installs matching Elixir and Erlang/OTP versions, finds your editors, and recommends the plugins that make Elixir development pleasant.",
    "license": "../LICENSE",
    "windows": {
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["English", "Russian"],
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "windows/nsis-header.bmp",
        "sidebarImage": "windows/nsis-sidebar.bmp",
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "language": {
          "en-US": {},
          "ru-RU": {
            "localePath": "windows/ru-RU.wxl"
          }
        },
        "bannerPath": "windows/wix-banner.bmp",
        "dialogImagePath": "windows/wix-dialog.bmp"
      }
    }
  }
}
